# Copy thành codebase/.env (đã gitignore) rồi điền key. KHÔNG điền key thật vào file này — nó được commit lên repo public.
# Biến môi trường có sẵn trên máy được ưu tiên hơn giá trị trong .env.

# Thứ tự nhà cung cấp; nhà nào không có key sẽ bị bỏ qua
# LLM_PROVIDERS=openai,deepseek,gemini

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_FALLBACK_MODELS=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek, hoặc cổng tương thích OpenAI không ép được JSON Schema (dùng json_object + kiểm schema bằng code)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4.1
# DEEPSEEK_FALLBACK_MODELS=deepseek-v4-flash

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest
# GEMINI_THINKING=low

# Thư mục data pack nếu không nằm ở ../K4-Hackathon/data/vlearn-pack hoặc ./data/vlearn-pack
# VLEARN_DATA_DIR=C:/VinAI/K4-Hackathon/data/vlearn-pack
